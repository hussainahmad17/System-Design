# Copy to .env and fill in. Never commit .env.
NODE_ENV=development
PORT=4000
# --- Production (EC2 behind Nginx) ---
# NODE_ENV=production
# HOST=127.0.0.1          only Nginx on the same machine can reach Node
# TRUST_PROXY=1           one proxy (Nginx) in front: read the real client IP
# COOKIE_SECURE=false     ONLY until HTTPS is set up; remove it afterwards
# CORS_ORIGIN=http://<elastic-ip>   later https://<your-domain>
# PORT is set per process by systemd (4001, 4002, 4003)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/imtiaz_mart
# Optional. npm run test:integration defaults to MONGODB_URI's cluster with database imtiaz_mart_test.
# TEST_MONGODB_URI=
CORS_ORIGIN=http://localhost:5173

# Optional. Redis cache (e.g. Redis Cloud). Without it the app reads everything from MongoDB.
REDIS_URL=redis://default:<password>@<host>:<port>

# Generate each with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=7

# Bloom filter size: expected users and false-positive rate (0.01 = 1%)
BLOOM_EXPECTED_ITEMS=1000000
BLOOM_FALSE_POSITIVE_RATE=0.01

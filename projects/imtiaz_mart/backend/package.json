{
  "name": "imtiaz-mart-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node --watch --env-file=.env src/server.js",
    "start": "node --env-file=.env src/server.js",
    "test": "node --test \"test/**/*.test.js\"",
    "test:integration": "node --env-file=.env test/integration/auth.flow.js && node --env-file=.env test/integration/orders.flow.js",
    "migrate:stock": "node --env-file=.env scripts/backfillStock.js",
    "seed:products": "node --env-file=.env scripts/seedProducts.js",
    "search:setup": "node --env-file=.env scripts/setupSearch.js"
  },
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.5",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.12.2",
    "redis": "^6.3.1",
    "zod": "^4.6.7"
  }
}
